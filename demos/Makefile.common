# This file is included in the individual project Makefiles,
# so the directories are deeper.
DEMO_DIR := $(abspath .)
DEMOS_DIR := $(abspath ..)
ROOT_DIR := $(abspath ../..)
COMPILER_DIR := $(ROOT_DIR)/compilers/c

LEXER := dune exec --root $(COMPILER_DIR) lexer --
PARSER := dune exec --root $(COMPILER_DIR) parser --
COMPILER := dune exec --root $(COMPILER_DIR) compiler --
TOOLCHAIN_MANIFEST := $(ROOT_DIR)/toolchain/Cargo.toml
EMULATOR_MANIFEST  := $(ROOT_DIR)/emulator/Cargo.toml

DEMO_NAME := $(notdir $(DEMO_DIR))
BUILD_DIR := $(DEMOS_DIR)/build/$(DEMO_NAME)
BIN := $(BUILD_DIR)/$(DEMO_NAME).bin

ASM := cargo run -q --manifest-path $(TOOLCHAIN_MANIFEST) -p viv32-asm --
LD  := cargo run -q --manifest-path $(TOOLCHAIN_MANIFEST) -p viv32-ld --
DIS := cargo run -q --manifest-path $(TOOLCHAIN_MANIFEST) -p viv32-dis --
EMU := cargo run -q --manifest-path $(EMULATOR_MANIFEST) --

C_NAMES := $(notdir $(C_SRCS))
ASM_NAMES := $(notdir $(ASM_SRCS))

ASM_OBJS := $(patsubst %.asm,$(BUILD_DIR)/%.vo,$(ASM_NAMES))
C_OBJS   := $(patsubst %.c, $(BUILD_DIR)/%.vo,$(C_NAMES))
OBJS := $(ASM_OBJS) $(C_OBJS)

EMU_ARGS ?=
DIS_ARGS ?=

.PHONY: all run disasm clean print-vars

all: $(BIN)

$(BIN): $(OBJS)
	@$(LD) $(OBJS) -o $@

$(BUILD_DIR)/%.asm: %.c
	@mkdir -p $(dir $@)
	@$(COMPILER) $< -o $@ $(COMPILER_FLAGS)

# Hand-written assembly from the demo directory
$(BUILD_DIR)/%.vo: %.asm
	@mkdir -p $(dir $@)
	@$(ASM) $< -o $@

# Library assembly
$(BUILD_DIR)/%.vo: ../lib/%.asm
	@mkdir -p $(dir $@)
	@$(ASM) $< -o $@

# Compiler-generated assembly already in BUILD_DIR
$(BUILD_DIR)/%.vo: $(BUILD_DIR)/%.asm
	@$(ASM) $< -o $@

$(BUILD_DIR)/device_config.toml: device_config.toml
	@cp $< $@

run: $(BIN) $(BUILD_DIR)/device_config.toml
	@cd $(BUILD_DIR) && $(EMU) device_config.toml $(EMU_ARGS)

disasm: $(BIN)
	$(DIS) $(BIN) $(DIS_ARGS)

clean:
	rm -rf $(BUILD_DIR)

print-vars:
	@echo DEMO_NAME=$(DEMO_NAME)
	@echo BUILD_DIR=$(BUILD_DIR)
	@echo ASM_SRCS=$(ASM_SRCS)
	@echo ASM_NAMES=$(ASM_NAMES)
	@echo OBJS=$(OBJS)
	@echo BIN=$(BIN)
